{
  "name": "baft",
  "displayName": "🧶 Baft",
  "description": "Architecture violation diagnostics powered by the 🧶 Baft CLI",
  "version": "0.2.0",
  "publisher": "dariushalipour",
  "repository": {
    "type": "git",
    "url": "https://github.com/dariushalipour/baft"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Linters", "Formatters"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "baft.restyleContract",
        "title": "Baft: Restyle Contract"
      }
    ],
    "configuration": {
      "title": "BAFT",
      "properties": {
        "baft.format.colorPalette": {
          "type": "string",
          "enum": ["vibrant", "muted", "mono", "none"],
          "default": "vibrant",
          "scope": "resource",
          "markdownDescription": "Specifies the Mermaid color palette BAFT uses when formatting BAFT.md files."
        },
        "baft.format.onSave": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Restyles BAFT.md files with BAFT whenever they are saved."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "baft.restyleContract",
          "when": "resourceScheme == file && resourceFilename == BAFT.md"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0"
  }
}
